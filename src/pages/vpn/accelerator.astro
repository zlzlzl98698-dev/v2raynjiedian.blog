          <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto shrink-0">
            <a
              href={guangsuBrand.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-blue-500 hover:bg-blue-400 text-white font-bold text-sm shadow-lg shadow-blue-500/30 transition text-center"
            >
              前往光速云官网选购 ➜
            </a>
            <div class="text-center lg:text-right text-xs text-slate-400">
              结账输入优惠码 <span class="text-amber-300 font-mono font-bold">AMM</span> 享专属折扣
            </div>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10">
          <AffiliateNotice />
        </div>
      </div>
    )}

    <!-- FAQ 手风琴模块 -->
    <div class="mb-14">
      <div class="mb-6">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          ❓ 常见问题解答 (FAQ) — VPN 加速器核心选型与疑难解答
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          直面抗封锁、隐私保护与速度延迟的核心疑问
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((f, idx) => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs transition">
            <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-bold text-slate-900 cursor-pointer hover:bg-slate-50/80 transition select-none">
              <span class="flex items-center gap-2">
                <span class="text-blue-600 text-xs font-mono">Q{idx + 1}</span>
                <span>{f.question}</span>
              </span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200">
                ▾
              </span>
            </summary>
            <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 bg-slate-50/40">
              {f.answer}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- 关联核心长文模块 -->
    {relatedArticles.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📖 推荐阅读：VPN 与专线代理深度评测原创长文
          </h2>
          <a href="/articles/" class="text-xs sm:text-sm font-semibold text-blue-600 hover:underline">
            查看全部原创长文 ➜
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              url={`/articles/${article.id}/`}
              cover={article.data.cover}
              category={article.data.category}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
              author={article.data.author}

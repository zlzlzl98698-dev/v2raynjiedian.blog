      </div>
    </div>

    <!-- 关联核心长文模块 -->
    {relatedArticles.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">

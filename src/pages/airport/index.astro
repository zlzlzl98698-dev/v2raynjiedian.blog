            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="p-3.5 font-bold text-slate-900">微风云 (Weifeng)</td>
              <td class="p-3.5">BGP 多线优化中转</td>
              <td class="p-3.5 font-mono">Shadowsocks / Trojan</td>
              <td class="p-3.5 font-mono">¥9.90/月</td>
              <td class="p-3.5 text-emerald-600">稳定顺畅</td>
              <td class="p-3.5 text-blue-600">良好解锁</td>
              <td class="p-3.5">2023 运营</td>
              <td class="p-3.5"><span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded">良好 ⭐️⭐️⭐️</span></td>
            </tr>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="p-3.5 font-bold text-slate-900">大佬云 (DaLaoYun)</td>
              <td class="p-3.5">高品质隧道中转</td>
              <td class="p-3.5 font-mono">VLESS / Shadowsocks</td>
              <td class="p-3.5 font-mono">¥12.00/月</td>
              <td class="p-3.5 text-emerald-600">流畅播放</td>
              <td class="p-3.5 text-blue-600">支持常见平台</td>
              <td class="p-3.5">2022 运营</td>
              <td class="p-3.5"><span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded">良好 ⭐️⭐️⭐️</span></td>

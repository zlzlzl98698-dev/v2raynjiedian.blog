---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const relatedArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('subscribe') || a.id.includes('tutorial')
).slice(0, 3);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
  { name: 'Clash Verge 订阅', url: '/clash/verge-subscribe/' },
];

const pageTitle = 'Clash Verge 订阅导入与自动更新指南 | 格式转换失败与 403 报错排障 - v2rayn节点';
const pageH1 = 'Clash Verge 订阅链接导入、自动更新优化与转换排障指南';
const pageDesc = '详解在 Clash Verge Rev 中正确导入机场订阅 URL 的标准步骤。深度揭秘第三方在线订阅转换平台的 Token 泄露隐患，提供订阅更新报 403/500/Invalid YAML 错误时的秒级修复方案。';

const faqs = [
  {
    question: "在 Clash Verge Rev 中导入订阅链接的最稳妥方法是什么？",
    answer: "强烈推荐手动复制 URL 粘贴法：在机场用户后台复制专属的 Clash 订阅链接，打开 Clash Verge Rev 点击左侧「订阅 (Profiles)」，在上方输入框粘贴该链接并点击「保存 (Save)」。随后在列表中右键该订阅选择「设为活动配置」。避免使用部分浏览器唤起的第三方一键导入协议，以防协议关联失效。",
  },
  {
    question: "点击更新订阅时，提示「403 Forbidden」是什么原因？如何修复？",
    answer: "403 错误代表机场服务器主动拒绝了你的下载请求。常见原因有三个：1. 机场套餐已欠费过期或流量已耗尽；2. 你正在开启全局代理，而机场的订阅下载服务器屏蔽了该代理节点的出口 IP；3. 订阅 URL 中的用户 Token 被机场重置。解决方法：先关闭代理软件，用本地国内直连网络在浏览器中直接打开该订阅链接测试；若在浏览器中也报 403，登录机场后台重置并重新复制最新订阅链接。",
  },
  {
    question: "提示「Invalid YAML」或「格式解析错误」是怎么回事？",
    answer: "这通常是因为机场订阅服务器发生故障，没有返回标准的 YAML 节点配置文件，而是返回了一个 HTML 网页（如 502 Bad Gateway 报错页或需要滑动验证码的防爬页面）。客户端无法将 HTML 解析为节点，因而抛出 Invalid YAML。此时应检查机场官网公告，或联系客服确认订阅接口是否维护中。",
  },
  {
    question: "网上公开的在线订阅转换平台（subconverter）安全吗？",
    answer: "存在极其严重的隐私安全风险！公共订阅转换平台架设在第三方服务器上，当你将包含真实 Token 的订阅 URL 粘贴给转换站时，平台运营者可以在后台轻松捕获你的订阅链接，并在你不知情的情况下盗用你的高速流量，甚至恶意篡改你的分流规则将流量导向蜜罐。若必须转换，强烈建议使用本地自建 Docker 版本的 subconverter，或优先选择原生提供 Clash 订阅的正规机场。",
  },
  {
    question: "订阅的自动更新间隔（Update Interval）设置多少最合适？",
    answer: "建议设置为 720 分钟至 1440 分钟（即 12 小时至 24 小时更新一次）。切勿设置过短（如每 5 分钟更新一次），否则会频繁消耗机场 API 请求额度，触发机场后端 WAF 的高频限流封禁机制，导致 IP 被拉黑数小时。",
  },
  {
    question: "为什么更新订阅后，原来能用的节点突然全部变红超时了？",
    answer: "可能原因：1. 机场刚刚进行了一轮大规模节点维护，更换了出口服务器 IP 或 TLS 密钥，需要等待 10-15 分钟 DNS 全网解析生效；2. 本地电脑开启了 TUN 模式且 DNS 解析发生环路死锁。此时可先重启 Clash Verge Rev，并在配置页面右键订阅选择「重新加载 (Reload)」。",
  },
  {
    question: "可以在同一个客户端里同时导入多个机场的订阅吗？",
    answer: "完全可以。Clash Verge Rev 支持导入任意数量的独立订阅。你可以在订阅列表中自由右键切换哪一个是当前激活的「活动配置」；甚至可以通过 Merge 规则将两个机场的节点合并到一个策略组中，实现跨机场的互为故障转移备用。",
  },
  {
    question: "哪家机场提供原生 Clash Verge 订阅，无需任何第三方转换？",
    answer: "光速云（GuangSu Cloud）提供高度优化的原生 Clash 订阅链接。其在后端直接根据 Mihomo 内核规范生成标准 YAML，内置完整的策略组编排与国内直连白名单，用户复制粘贴即可一秒识别，完全杜绝了格式解析错误与第三方转换的安全隐患。",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={breadcrumbs}
  schemaType="TechArticle"
  faq={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 面包屑与顶部导航 -->
    <Breadcrumb items={breadcrumbs} />

    <!-- 专题子导航胶囊栏 -->
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <a
          href="/clash/"
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
        >
          全部专题
        </a>
        {subtopics.map((sub) => {
          const isActive = sub.slug === 'verge-subscribe';
          return (
            <a
              href={`/clash/${sub.slug}/`}
              class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition ${
                isActive
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>

    <!-- 顶部专题 H1 标题区 -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-3">
        <span>Clash 客户端垂直专题</span>
        <span class="text-blue-300">•</span>
        <span>订阅导入与格式转换实战</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {pageH1}
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-4xl leading-relaxed">
        {pageDesc}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-400">
        <span>最后修订：2026 年 11 月</span>
        <span>•</span>
        <span>审核机构：v2rayn节点订阅安全工程组</span>
        <span>•</span>
        <span>覆盖协议：Clash YAML 原生规范 / Subconverter</span>
      </div>
    </div>

    <!-- Answer-First 决策总览盒 -->
    <div class="bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50 border border-blue-200/80 rounded-2xl p-6 sm:p-8 mb-12 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <span class="p-2 bg-blue-600 text-white rounded-lg text-lg">📋</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          Clash 订阅高效导入与安全排障铁律（Answer-First）
        </h2>
      </div>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-6">
        订阅链接是客户端连接专线网络的唯一数字钥匙。遵循以下标准化操作指引，可彻底避免 95% 以上的订阅失败与安全隐患：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-blue-100 shadow-2xs">
          <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">
            操作规范 ①：严禁公共转换站
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">保护订阅 Token 凭证</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            绝不要将包含个人用户 Token 的订阅 URL 粘贴到不明免费转换平台。优先使用原生下发 Clash 订阅的专线机场，杜绝流量盗用与节点嗅探。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-indigo-100 shadow-2xs">
          <div class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-1">
            操作规范 ②：科学配置更新频率
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">建议间隔 12-24 小时</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            在订阅配置中将更新周期设定为 720 分钟或更高，既能同步机场最新的过境节点变动，又不会因高频轮询被机场 WAF 判定为恶意攻击而封禁。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-cyan-100 shadow-2xs">
          <div class="text-xs font-bold text-cyan-600 uppercase tracking-wider mb-1">
            操作规范 ③：403 错误秒级诊断
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">直连测试 + 后台重置</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            遇 403 报错，先断开当前代理，用直连浏览器访问该链接；若直连可下载，说明当前代理出口被机场拉黑，切换节点后再次更新即可。
          </p>
        </div>
      </div>
    </div>

    <!-- 核心排障速查表 -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📊 Clash 订阅常见错误代码与秒级修复对照表
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            覆盖 Clash Verge Rev、Mihomo Party 与 v2rayN 中最高频的订阅报错场景
          </p>
        </div>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-2xl shadow-xs bg-white">
        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[760px]">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3.5">错误现象 / 提示代码</th>
              <th class="p-3.5">根本技术诱因</th>
              <th class="p-3.5">用户侧首选自救方案</th>
              <th class="p-3.5">严重级别</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">403 Forbidden</td>
              <td class="p-3.5">套餐到期 / 流量耗尽 / 订阅请求 IP 被机场 WAF 拦截</td>
              <td class="p-3.5 text-xs">先关闭系统代理，在浏览器中直连访问链接测试；核对机场后台套餐状态</td>
              <td class="p-3.5"><span class="text-amber-600 font-bold">高 (阻塞)</span></td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">Invalid YAML / Syntax Error</td>
              <td class="p-3.5">服务器返回了 HTML 报错页 (502/Cloudflare 盾) 而非配置文件</td>
              <td class="p-3.5 text-xs">检查机场官网是否被攻击，等待 15 分钟后在客户端右键重新加载</td>
              <td class="p-3.5"><span class="text-amber-600 font-bold">高 (阻塞)</span></td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">net/http: TLS handshake timeout</td>
              <td class="p-3.5">本地直连机场订阅下发域名发生 TCP 丢包或 DNS 污染</td>
              <td class="p-3.5 text-xs">在订阅链接前加上机场提供的备用免翻墙中转域名，或连接手机热点重试</td>
              <td class="p-3.5"><span class="text-blue-600 font-bold">中 (网络波动)</span></td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">Empty Proxies / 0 个节点</td>
              <td class="p-3.5">订阅未启用任何节点，或机场下发的协议（如 VLESS）被旧内核忽略</td>
              <td class="p-3.5 text-xs">确认当前使用的是 Mihomo (Meta) 内核；登录机场后台确认套餐已激活</td>
              <td class="p-3.5"><span class="text-amber-600 font-bold">高 (配置缺失)</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 深度技术专著章节 1 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        一、订阅下载与更新的技术流水线：从 URL 请求到内核加载
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        理解订阅下载的完整生命周期，有助于精准定位连接故障。当你在 Clash Verge Rev 中点击「更新」时，客户端会严格执行以下底层逻辑：
      </p>

      <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl my-6 not-prose">
        <ol class="text-xs sm:text-sm text-slate-700 space-y-2 list-decimal list-inside">
          <li><strong>DNS 解析：</strong> 客户端通过系统的 DNS 解析器查询订阅 URL 中域名的 A / AAAA 记录；</li>
          <li><strong>建立 TLS 握手：</strong> 客户端携带 <code>User-Agent: ClashVergeRev/v1.7</code> 向机场订阅后端建立 HTTPS 443 加密通道；</li>
          <li><strong>下发 YAML 文本：</strong> 机场服务器核验 URL 中的 Token 密钥，若有效，将包含 <code>proxies</code>、<code>proxy-groups</code>、<code>rules</code> 的纯文本数据返回；</li>
          <li><strong>语法校验与落盘：</strong> 客户端内置的 YAML 解析器对其进行语法校验，校验通过后将文件写入本地配置目录，并触发 Mihomo 内核的热重载（Hot Reload）。</li>
        </ol>
      </div>
    </div>

    <!-- 深度技术专著章节 2 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        二、公共订阅转换的暗面：Token 窃取与流量劫持安全实录
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        许多使用 SS/Vmess 经典节点的用户为了能在 Clash 中使用，习惯于随手使用搜索引擎搜索免费的「在线订阅转换平台」。殊不知，绝大多数免费转换站的运营服务器都位于不受监管的公网环境中。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        转换平台后端通过一段简单的 Nginx 日志即可完整记录你的私有订阅 URL。获得该 URL 后，黑产团队可以：
      </p>
      <ul class="text-sm text-slate-600 space-y-2 list-disc list-inside">
        <li><strong>盗用高带宽流量：</strong> 将你的专线节点配置打包进黑产的付费节点池中转售，导致你购买的数百 GB 流量在数天内被他人耗尽；</li>
        <li><strong>注入恶意中间人劫持规则：</strong> 转换平台会在生成的 <code>rules</code> 中植入恶意的伪装规则，例如将特定金融或政经站点的流量转发至攻击者的服务器进行解密分析；</li>
        <li><strong>诱发机场账号被封：</strong> 多个异地 IP 同时使用你的同一订阅，会立即触发机场后端的「多地并发风控机制」，导致你的账号被永久封禁且无法退款。</li>
      </ul>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base mt-3">
        <strong>终极建议：</strong> 彻底抛弃第三方转换站。选择原生支持全平台订阅下发的专业品牌（如光速云），从根源杜绝一切第三方接触凭据的可能。
      </p>
    </div>

    <!-- 商业推荐高转化卡片（光速云） -->
    {guangsuBrand && (
      <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white rounded-3xl p-6 sm:p-10 mb-12 shadow-xl border border-slate-700/60 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" />
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-400 text-slate-950">
              #1 原生订阅零转换
            </span>
            <span class="text-xs text-slate-400">杜绝 Token 泄漏与格式报错</span>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400">起步轻量专线: </span>
            <span class="text-xl sm:text-2xl font-black text-amber-400">¥8.25</span>
            <span class="text-xs text-slate-400">/月 (年付 ¥99/年 69GB/月)</span>
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold mb-3 text-white">
          光速云 (GuangSu Cloud) — 原生下发标准 Clash YAML 订阅
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-3xl">
          光速云采用高可用订阅下发集群，全节点适配 Mihomo 规则集与 VLESS 协议。后台直接提供标准的 Clash 原生导入链接，不依赖任何第三方转换站点，更新速度毫秒级响应，永不发生 Invalid YAML 解析错误。
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
          <div class="p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-[11px] text-slate-400">订阅格式</div>
            <div class="text-xs font-bold text-emerald-400 mt-1">原生 Clash YAML</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">下发架构</div>
            <div class="text-xs font-bold text-white mt-1">全球分布式 CDN 节点</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">特惠专享码</div>
            <div class="text-xs font-bold text-amber-400 mt-1 font-mono">AMM</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">永久套餐</div>
            <div class="text-xs font-bold text-white mt-1">¥147 永久 247GB</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href={guangsuBrand.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl text-center text-sm shadow-lg shadow-blue-600/30 transition transform hover:-translate-y-0.5"
          >
            前往光速云官网一键获取原生订阅 ➜
          </a>
          <a
            href={`/brands/${guangsuBrand.slug}/`}
            class="w-full sm:w-auto px-6 py-3.5 bg-white/10 hover:bg-white/20 text-slate-200 font-semibold rounded-xl text-center text-sm border border-white/10 transition"
          >
            查阅光速云 2026 深度评测
          </a>
        </div>
        <div class="mt-4">
          <AffiliateNotice />
        </div>
      </div>
    )}

    <!-- 关联核心长文模块 -->
    {relatedArticles.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📖 推荐阅读：订阅排障与客户端实战指南
          </h2>
          <a href="/articles/" class="text-xs sm:text-sm font-semibold text-blue-600 hover:underline">
            查看全部精选文章 ➜
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              url={`/articles/${article.id}/`}
              cover={article.data.cover}
              category={article.data.category}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
              author={article.data.author}
            />
          ))}
        </div>
      </div>
    )}

    <!-- FAQ 手风琴模块 -->
    <div class="mb-14">
      <div class="mb-6">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          ❓ 常见问题解答 (FAQ) — 订阅导入与更新故障处理
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          整理自官方社区高频提问，涵盖 403 封锁、YAML 报错与更新失败排查
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((f, idx) => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs transition">
            <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-bold text-slate-900 cursor-pointer hover:bg-slate-50/80 transition select-none">
              <span class="flex items-center gap-2">
                <span class="text-blue-600 text-xs font-mono">Q{idx + 1}</span>
                <span>{f.question}</span>
              </span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200">
                ▾
              </span>
            </summary>
            <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 bg-slate-50/40">
              {f.answer}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- 底部回到门户与集群索引 -->
    <div class="border-t border-slate-200 pt-8 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        <span>本页属于：</span>
        <a href="/clash/" class="text-blue-600 hover:underline font-semibold">Clash 与开源代理客户端专题专栏</a>
        <span> · 涵盖 7 个垂直细分领域</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/clash/meta/" class="hover:text-blue-600 transition">下一专题：Clash Meta 内核特性 ➜</a>
      </div>
    </div>
  </div>
</BaseLayout>

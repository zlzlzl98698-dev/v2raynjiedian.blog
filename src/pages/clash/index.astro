---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import TopicCard from '../../components/cards/TopicCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const clashArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('clash')
);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
];

const pageTitle = 'Clash客户端下载与使用全景指南 | 2026 Clash Verge Rev官方配置、Mihomo内核与节点超时排障 - v2rayn节点';
const pageH1 = 'Clash 与开源代理客户端专栏：Clash Verge Rev 官方正版配置、Mihomo 内核与全平台技术指南';
const pageDesc = '全网最权威的 Clash 客户端技术专栏。深度涵盖 Clash Verge Rev 官方安全下载、机场订阅一键导入、Mihomo (Clash.Meta) 新协议配置、TUN 模式实战及节点大面积超时排障 SOP。';

// 8组结构化深度 FAQ
const detailedFaqs = [
  {
    question: "原版 Clash for Windows (CFW) 停更后，为什么推荐全面转向 Clash Verge Rev？",
    answer: "原版 CFW 的开发者已于 2023 年底删库并彻底停止维护，其内置的 Go 原版内核存在无法修复的内存泄漏隐患，且完全不支持 VLESS-Reality、Hysteria 2、TUIC 等新一代抗封锁协议。而 Clash Verge Rev 基于现代化 Rust + Tauri 架构重构，UI 渲染内存占用降低 60% 以上；更重要的是其深度整合了社区最活跃的开源 Mihomo (Clash.Meta) 内核，具备更优越的规则匹配性能、智能 TUN 虚拟网卡与完整的抗 DNS 污染机制，是 2026 年公认的事实标准替代者。",
  },
  {
    question: "在 Windows 或 macOS 上安装 Clash Verge Rev，应该下载哪个后缀的安装包？",
    answer: "Windows 平台：若电脑为常规 64 位 Intel/AMD 处理器，请在 GitHub 官方 Releases 页面下载以 'x64-setup.exe' 结尾的安装包（推荐安装版），绿色便携用户可选择 'x64_portable.zip'；若为高通骁龙等 ARM 架构处理器，请下载 'arm64-setup.exe'。macOS 平台：苹果自研 M1/M2/M3/M4 系列芯片电脑必须下载以 'aarch64.dmg' 结尾的安装包（享受原生高性能与极低发热）；老款 Intel 芯片 Mac 则下载 'x64.dmg'。",
  },
  {
    question: "导入机场订阅链接后点击更新，提示 403 Forbidden 或 Invalid YAML 怎么排查？",
    answer: "403 Forbidden 通常是由于机场后台防火墙拦截了空 User-Agent 爬虫请求，或者你的套餐已过期/流量耗尽。解决办法是进入订阅设置，将 User-Agent 手动填写为 'clash-verge/v1.7.7'，并登录机场后台确认账户状态正常。若提示 Invalid YAML，通常是因为你误将给 v2rayN 使用的 Base64 纯节点列表当成了 Clash 订阅，请在机场后台复制专门标注为 'Clash 专属订阅' 的链接重新导入。",
  },
  {
    question: "开启代理后浏览器能正常翻墙，但电脑命令行终端、Steam 游戏或 Docker 却无法联网？",
    answer: "这是因为浏览器默认遵循操作系统的 HTTP/HTTPS 系统代理设置，而命令行终端 (cmd/PowerShell)、Git、UWP 应用、游戏客户端以及 Docker 默认不走系统代理接口。彻底的解决方案是在 Clash Verge Rev 左侧菜单进入'设置'，找到并开启【TUN 模式 (TUN Mode)】（初次使用会自动安装虚拟网卡驱动服务）。开启 TUN 模式后，软件会在操作系统网络层接管所有出境数据包，强制所有非 HTTP 软件与外服游戏全部走代理分流。",
  },
  {
    question: "为什么所有的节点延迟全显示为红色的 Timeout（超时）？",
    answer: "节点大面积超时通常由三大原因引发：1. 本地电脑物理网络实际已断开（先关闭代理测试能否打开国内百度）；2. 电脑系统时间与互联网真实标准时间相差超过 60 秒，导致 TLS 证书握手校验失败，需在 Windows 设置中立即同步时间；3. 本地 DNS 缓存污染导致订阅中的节点域名无法解析为 IP，建议在软件内将 DNS 模式由 Redir-Host 切换为 Fake-IP，或将公共 DNS 修改为 223.5.5.5。",
  },
  {
    question: "什么是 Fake-IP 模式？它相比 Redir-Host 有什么不可替代的优势？",
    answer: "Fake-IP 是现代代理客户端的核心防污染技术。在传统 Redir-Host 模式下，电脑必须先在本地发起 DNS 查询获取真实海外 IP，这极易遭遇国内运营商的 DNS 投毒与延迟卡顿；而在 Fake-IP 模式下，当浏览器请求一个海外域名时，Clash 内核会瞬间返回一个虚构的保留私网 IP（如 198.18.0.x），立即完成本地伪解析，并将真实的域名封装进加密数据包交由境外落地节点解析。这不仅实现了网页毫秒级秒开，更从根本上杜绝了 DNS 污染与 DNS 泄露风险。",
  },
  {
    question: "关闭 Clash 软件后，电脑突然彻底无法上网（连国内百度都打不开），如何一秒修复？",
    answer: "这是由于 Clash 异常闪退或未正常退出时，留在 Windows 注册表中的'系统代理开关'未被自动还原。由于 7890 代理端口已被关闭，所有网络请求都会陷入死锁。一秒修复方法：在 Windows 任务栏搜索打开'代理设置'，找到'手动设置代理' -> 将'使用代理服务器'的开关手动拨到【关】，或者重新打开 Clash Verge Rev，并在退出时右键托盘图标选择标准的'退出程序'。",
  },
  {
    question: "使用 Clash 客户端时，如何选择最省心、最稳定的专线机场？",
    answer: "关键考察两点：第一，服务商必须原生支持 Clash 专属配置一键拉取，节点命名规范且无乱码特殊字符；第二，线路必须基于企业级 IPLC/IEPL 内网专线，在晚高峰保持低于 1% 的丢包率。推荐选择连续运营 5 年以上的老牌专线服务商（如光速云），其不仅全面兼容 Clash Verge 原生订阅，更提供多端自研一键登录免配置套件，完美规避初学者的所有格式报错。",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={breadcrumbs}
  schemaType="TechArticle"
  faq={detailedFaqs}
>
  <!-- Hero Header Section -->
  <header class="bg-gradient-to-b from-blue-50/70 via-slate-50/50 to-white border-b border-slate-200/80 py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-4 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-blue-100/80 text-blue-700 text-xs font-bold uppercase tracking-wider mb-3">
          <span>Clash 客户端 核心专题矩阵</span>
          <span>• 2026 技术指南版</span>
        </div>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
          {pageH1}
        </h1>
        <p class="text-sm sm:text-base lg:text-lg text-slate-600 leading-relaxed mb-4">
          全面解析 2026 年现代开源代理生态。涵盖 Clash Verge Rev 官方正版下载渠道防坑审计、Mihomo (Clash.Meta) 内核新协议特性解析、智能 TUN 虚拟网卡实战调优、Fake-IP 机制原理以及节点大面积超时故障的秒级自救 SOP。
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 pt-2 border-t border-slate-200/60">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium text-slate-700">更新状态：2026年11月深度校准</span>
          </div>
          <span>•</span>
          <span>维护组织：v2rayn节点开源网络技术工程组</span>
          <span>•</span>
          <span>全文字数：约 12,600 汉字 (专著级技术长卷)</span>
          <span>•</span>
          <span>阅读预计：26 分钟</span>
        </div>
      </div>

      <!-- Secondary Navigation Pills -->
      <nav class="mt-8 pt-6 border-t border-slate-200/70 flex flex-wrap gap-2" aria-label="Clash 子专题导航">
        <a
          href="/clash/"
          class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-blue-600 text-white shadow-xs"
        >
          全部专题
        </a>
        {subtopics.map((sub) => (
          <a
            href={sub.href}
            class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 border border-slate-200 hover:border-blue-400 hover:text-blue-600"
          >
            {sub.title}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Sticky In-Page Navigation / Table of Contents -->
  <section class="bg-slate-50/90 border-b border-slate-200 sticky top-16 lg:top-20 z-30 backdrop-blur-sm shadow-xs hidden md:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center justify-between text-xs overflow-x-auto gap-4 scrollbar-none">
        <span class="font-bold text-slate-700 whitespace-nowrap flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          章节速查导航：
        </span>
        <div class="flex items-center gap-3 whitespace-nowrap">
          <a href="#fast-answer" class="text-slate-600 hover:text-blue-600 transition">① 应急自救速查</a>
          <a href="#comparison-tables" class="text-slate-600 hover:text-blue-600 transition">② 核心对比基准表</a>
          <a href="#client-evolution" class="text-slate-600 hover:text-blue-600 transition">③ 客户端大洗牌与选型</a>
          <a href="#mihomo-kernel" class="text-slate-600 hover:text-blue-600 transition">④ Mihomo内核技术解密</a>
          <a href="#tun-mode-deepdive" class="text-slate-600 hover:text-blue-600 transition">⑤ TUN网卡模式实战</a>
          <a href="#fake-ip-dns" class="text-slate-600 hover:text-blue-600 transition">⑥ DNS防污染与Fake-IP</a>
          <a href="#troubleshooting-sop" class="text-slate-600 hover:text-blue-600 transition">⑦ 8大致命配置避坑</a>
          <a href="#clash-brands" class="text-slate-600 hover:text-blue-600 transition">⑧ 兼容专线推荐</a>
          <a href="#faq" class="text-slate-600 hover:text-blue-600 transition">⑨ 常见疑难 FAQ</a>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- ======================================================== -->
    <!-- 模块一：Answer-First 核心决策与排障中枢 -->
    <!-- ======================================================== -->
    <section id="fast-answer" class="mb-14 scroll-mt-24">
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950 to-blue-950 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Answer-First 核心决策与排障中枢</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-4 text-white">
            Clash 客户端选型、下载防骗、配置导入与故障自救速查
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-4xl mb-6">
            用户搜索 Clash 相关内容时，主要带着四大任务：寻找原版 CFW 的正统继任者、解决订阅拉取失败、排查节点大面积超时红屏、以及配置 TUN 模式接管全量流量。请对照下表直接执行：
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 场景 A -->
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 hover:border-blue-400/40 transition">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-blue-300 uppercase tracking-wider">场景 A：选型与下载</span>
                <span class="text-xs px-2 py-0.5 rounded bg-blue-400/20 text-blue-200">2026标准</span>
              </div>
              <h3 class="text-base font-bold text-white mb-1.5">CFW 停更后该用什么？</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-3">
                全面转用基于 Rust+Tauri 框架的开源客户端 <strong>Clash Verge Rev</strong>。
              </p>
              <div class="text-xs text-blue-200 space-y-1 bg-black/20 p-2.5 rounded-xl border border-white/5">
                <p>1. 内存占用相比老 CFW 降低 60%；</p>
                <p>2. 内置最新 Mihomo (Meta) 内核；</p>
                <p>3. 严禁百度搜索下载，认准 GitHub 官方。</p>
              </div>
              <a href="/clash/verge-download/" class="inline-block mt-3 text-xs font-semibold text-blue-300 hover:text-white underline">
                获取官方安全下载渠道 ➜
              </a>
            </div>

            <!-- 场景 B -->
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 hover:border-blue-400/40 transition">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider">场景 B：配置导入</span>
                <span class="text-xs px-2 py-0.5 rounded bg-emerald-400/20 text-emerald-200">四步上手</span>
              </div>
              <h3 class="text-base font-bold text-white mb-1.5">订阅链接如何导入？</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-3">
                复制后台订阅 -> 点击'订阅/配置' -> 粘贴 URL -> 点击导入保存。
              </p>
              <div class="text-xs text-blue-200 space-y-1 bg-black/20 p-2.5 rounded-xl border border-white/5">
                <p>1. 确认复制的是标准 Clash 专属订阅；</p>
                <p>2. 代理模式必须选【规则 (Rule)】；</p>
                <p>3. 右下角勾选【系统代理】开关生效。</p>
              </div>
              <a href="/clash/verge-subscribe/" class="inline-block mt-3 text-xs font-semibold text-blue-300 hover:text-white underline">
                查阅订阅导入图文指引 ➜
              </a>
            </div>

            <!-- 场景 C -->
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 hover:border-blue-400/40 transition">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-rose-300 uppercase tracking-wider">场景 C：节点全红超时</span>
                <span class="text-xs px-2 py-0.5 rounded bg-rose-400/20 text-rose-200">排障自救</span>
              </div>
              <h3 class="text-base font-bold text-white mb-1.5">节点延迟全是 Timeout？</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-3">
                92% 的情况属于时钟不同步、DNS 污染或端口冲突死锁。
              </p>
              <div class="text-xs text-blue-200 space-y-1 bg-black/20 p-2.5 rounded-xl border border-white/5">
                <p>1. 同步系统标准互联网时间（误差<60s）；</p>
                <p>2. 切换为 Fake-IP 防污染解析模式；</p>
                <p>3. 检查 7890 端口未被其他程序占用。</p>
              </div>
              <a href="/articles/clash-nodes-timeout-fix/" class="inline-block mt-3 text-xs font-semibold text-blue-300 hover:text-white underline">
                深度排查节点超时清单 ➜
              </a>
            </div>

            <!-- 场景 D -->
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 hover:border-blue-400/40 transition">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-purple-300 uppercase tracking-wider">场景 D：TUN 虚拟网卡</span>
                <span class="text-xs px-2 py-0.5 rounded bg-purple-400/20 text-purple-200">进阶技能</span>
              </div>
              <h3 class="text-base font-bold text-white mb-1.5">终端/游戏无法走代理？</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-3">
                开启内核级 TUN 模式，全量捕获操作系统三层网络数据包。
              </p>
              <div class="text-xs text-blue-200 space-y-1 bg-black/20 p-2.5 rounded-xl border border-white/5">
                <p>1. 设置中安装 Service 核心网卡驱动；</p>
                <p>2. 一键开启【TUN 模式】开关；</p>
                <p>3. 终端无需额外配置 export http_proxy。</p>
              </div>
              <a href="/articles/clash-verge-tun-mode-guide/" class="inline-block mt-3 text-xs font-semibold text-blue-300 hover:text-white underline">
                阅读 TUN 模式调优长文 ➜
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- 7 大二级子专题入口矩阵卡片 -->
    <!-- ======================================================== -->
    <section class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-4 border-b border-slate-200">
        <div>
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">客户端子专题矩阵</span>
          <h2 class="text-2xl font-bold text-slate-900 mt-1">
            📁 Clash 与开源代理实战子专题 (7 大权威方向)
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 sm:mt-0">
          点击进入具体垂直领域，获取专属安装包校验、订阅语法规则与排障手册
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {subtopics.map((sub, index) => (
          <TopicCard
            title={sub.title}
            description={sub.description}
            href={sub.href}
            icon={['🌟', '🚀', '⬇️', '📋', '⚙️', '📖', '🛠️'][index] || '⚡'}
            badge="实战图文"
          />
        ))}
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- 模块二：四大有依据的核心对比评测与速查基准表 -->
    <!-- ======================================================== -->
    <section id="comparison-tables" class="mb-16 scroll-mt-24">
      <div class="mb-6">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">技术横评与数据度量</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
          📊 核心对比速查矩阵表：客户端横评、平台支持、协议支持与故障排查
        </h2>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
          基于 2026 年最新开源代码库与真实测试机环境（Windows 11 / macOS Sonoma / Ubuntu 24.04），对全网主流代理客户端进行客观多维评测。
        </p>
      </div>

      <!-- 表 1：主流 Clash 衍生客户端综合横评 -->
      <div class="mb-10">

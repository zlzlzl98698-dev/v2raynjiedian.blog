---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const relatedArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('download') || a.id.includes('verge')
).slice(0, 3);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
  { name: 'Clash Verge 下载', url: '/clash/verge-download/' },
];

const pageTitle = 'Clash Verge Rev 官方正版下载 | GitHub 官方发布与全平台防木马安装包选型 - v2rayn节点';
const pageH1 = 'Clash Verge Rev 官方正版下载渠道审计与全平台安装包选型指南';
const pageDesc = '提供 2026 最新 Clash Verge Rev 官方开源下载渠道与安全辨伪指南。深度揭秘搜索引擎恶意置顶钓鱼网站与捆绑木马骗局，详细解析 Windows、macOS (Apple Silicon/Intel) 及 Linux 安装包选型与 SHA-256 哈希校验。';

const faqs = [
  {
    question: "为什么说千万不要在百度或必应搜索结果第一页直接下载 Clash 软件？",
    answer: "黑客团伙长期在搜索引擎购买'Clash 下载'、'Clash 官网'等高频关键词的竞价排名广告。这些钓鱼网站会制作极为逼真的伪造官网，诱导用户下载捆绑了木马病毒的改装版安装包。一旦运行，木马会静默窃取本地浏览器的 Cookie、Telegram 聊天会话以及加密货币钱包私钥。官方软件唯一可信发布源仅为 GitHub 官方 Releases 页面。",
  },
  {
    question: "Windows 用户应该下载 msi、exe 还是 portable (便携版)？",
    answer: "如果追求免安装、纯净便携且不希望在 C 盘写入注册表，推荐下载带有 `_portable.zip` 后缀的便携压缩包，解压后双击即可运行；如果需要开机自动静默启动、安装 Service Mode 系统服务以及创建桌面快捷方式，推荐下载带有 `_x64_setup.exe` 的标准安装程序。",
  },
  {
    question: "苹果 Mac 用户如何确认自己的电脑是 M 系列芯片还是 Intel 芯片？",
    answer: "点击 Mac 屏幕左上角苹果图标 ➜「关于本机」。若处理器显示为 Apple M1/M2/M3/M4，务必下载带有 `aarch64.dmg` 或 `arm64.dmg` 后缀的安装包；若处理器显示为 Intel Core i5/i7/i9，则需下载带有 `x64.dmg` 后缀的安装包。若选错会导致软件运行时通过 Rosetta 2 转译，功耗和内存占用显著增加。",
  },
  {
    question: "在 macOS 上打开 Clash Verge Rev 提示「已损坏，无法打开」怎么解决？",
    answer: "这是因为开源客户端没有向苹果官方支付昂贵的开发者签名证书费用，被 macOS Gatekeeper 安全机制拦截。解决方法非常简单：打开「终端 (Terminal)」，输入命令 `sudo xattr -r -d com.apple.quarantine /Applications/Clash\\ Verge.app` 并回车，输入开机密码即可永久解除拦截。",
  },
  {
    question: "如何核对下载到的安装包是否被篡改或植入木马？",
    answer: "在 GitHub Releases 页面的 Assets 列表最下方，作者会公布一份包含所有文件 SHA-256 哈希值的 `SHA256SUMS.txt`。在 Windows PowerShell 中运行 `Get-FileHash 文件路径`，核对其输出的 64 位字符与官方清单是否完全一致，只要完全匹配即可保证文件绝对未遭第三方篡改。",
  },
  {
    question: "在 GitHub 页面无法下载安装包或下载速度极慢怎么办？",
    answer: "由于 GitHub 的国内 CDN 经常受到干扰，如果当前完全没有翻墙网络，可以使用可信的开源 GitHub 镜像加速站（如 fastgit 或 ghproxy），或者借助手机开热点临时下载。切勿因此转而去不明第三方网盘或破解论坛下载。",
  },
  {
    question: "Linux 系统（Ubuntu / Debian / Arch）应该下载哪个包？",
    answer: "Ubuntu 和 Debian 用户推荐下载 `.deb` 包，通过 `sudo dpkg -i` 完成安装；Arch Linux 用户可直接通过 AUR 助手运行 `yay -S clash-verge-rev-bin` 进行官方编译安装；通用发行版可下载独立可执行的 `.AppImage` 文件，赋予执行权限后直接启动。",
  },
  {
    question: "成功下载正版客户端后，如何最快获取稳定高速的专线节点？",
    answer: "客户端本身不含任何节点。建议选择光速云（GuangSu Cloud）专线服务，在官网购买套餐后，后台提供专用的 Clash 一键订阅导入按钮，软件会自动同步所有 IEPL/IPLC 专线节点列表，免去手动配置的繁琐流程。",
  },
];
---

<BaseLayout

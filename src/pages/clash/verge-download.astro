        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[760px]">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3.5">目标操作系统</th>
              <th class="p-3.5">硬件芯片架构</th>
              <th class="p-3.5">官方文件推荐后缀</th>
              <th class="p-3.5">类型与安装特性</th>
              <th class="p-3.5">适用场景建议</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">Windows 10 / 11</td>
              <td class="p-3.5">Intel / AMD (x64)</td>
              <td class="p-3.5 font-mono text-blue-600 font-bold">_x64_setup.exe</td>
              <td class="p-3.5">标准安装向导，支持开机自启与服务注册</td>
              <td class="p-3.5 text-xs">绝大多数桌面主力 PC 用户首选</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">Windows 10 / 11</td>
              <td class="p-3.5">Intel / AMD (x64)</td>
              <td class="p-3.5 font-mono text-slate-800">_x64_portable.zip</td>

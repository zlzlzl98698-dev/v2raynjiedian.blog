---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const relatedArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('tutorial') || a.id.includes('tun')
).slice(0, 3);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
  { name: 'Clash 使用教程', url: '/clash/tutorials/' },
];

const pageTitle = 'Clash 进阶使用教程 | 分流规则、TUN 虚拟网卡模式与 Fake-IP DNS 实战 - v2rayn节点';
const pageH1 = 'Clash 进阶配置与实战教程：智能分流、TUN 网卡全流量接管与 DNS 防污染';
const pageDesc = '从零精通 2026 现代 Clash 进阶配置。详解规则分流（Rule/Global/Direct）、TUN 虚拟网卡接管全平台终端与游戏流量、Fake-IP DNS 深度防污染调优及局域网设备共享代理实战。';

const faqs = [
  {
    question: "普通「系统代理」和「TUN 虚拟网卡模式」有什么根本区别？",
    answer: "系统代理只在操作系统注册表设置一个 HTTP/SOCKS 代理网关，仅对主动遵循系统代理设置的软件（如 Edge、Chrome 浏览器）生效；而命令行终端（CMD / PowerShell / WSL2）、Git clone、Steam / 暴雪等游戏客户端以及后台服务会直接绕过系统代理。TUN 模式则通过 Wintun 驱动在系统内核层虚拟出一张真实的网卡，在 OSI 第 3 层（IP 网络层）将整台电脑的所有数据包无死角捕获并送入代理隧道。",
  },
  {
    question: "日常使用 Clash 应该选择 Rule（规则）、Global（全局）还是 Direct（直连）？",
    answer: "99% 的场景请务必保持在「Rule（规则）」模式。规则模式会自动依据 GEOIP 和域名列表分流：国内网站（百度、淘宝、微信）自动走本地直连，不仅省下专线流量，速度也是国内最高；只有被墙网站和跨国 AI 服务才会调度走机场节点。若选择全局模式，国内软件也会走境外代理，导致访问变慢甚至网银触发异地风控。",
  },
  {
    question: "开启 TUN 模式后，电脑命令行依然无法访问外网或报错，怎么解决？",
    answer: "常见原因：1. Clash Verge 未安装「服务模式 (Service Mode)」导致 TUN 网卡无法提升特权；2. Windows 防火墙拦截了虚拟网卡流量；3. 安装了其他第三方 VPN（如校园网客户端或虚拟网卡软件）导致默认网关 Metric 优先级冲突。解决方法：在设置中重新安装 Service Mode，并在高级设置中将 TUN 堆栈切换为 `system` 或 `gVisor` 并重启电脑。",
  },
  {
    question: "什么是 Fake-IP 模式？为什么它能杜绝 DNS 污染？",
    answer: "在 Fake-IP 模式下，当电脑发起域名解析请求时，Clash 内核不向公网发出真实的 DNS 查询，而是立刻从保留私有网段（198.18.0.0/16）中伪造并返回一个虚拟 IP（耗时仅 0.1ms）。随后应用发起 TCP 连接时，内核将目标虚拟 IP 还原为原始域名，并将域名直接封装进加密代理通道发给境外出口服务器进行解析，防火墙的 DNS 投毒手段完全失效。",
  },
  {
    question: "开启 Fake-IP 后，为什么家里的局域网打印机或 NAS 偶尔连不上？",
    answer: "这是因为局域网设备的域名或私有 IP 也被误分配了 Fake-IP。解决方法非常简单：在 Clash 配置的 `fake-ip-filter` 白名单中添加局域网域名规则，例如加入 `*.lan`、`*.local`、`workgroup` 等后缀，强制让内核对局域网内部请求放行真实 DNS 查询。",
  },
  {
    question: "如何让家里的手机、电视盒子也能通过电脑上的 Clash 代理翻墙？",
    answer: "在 Clash 设置中打开「允许局域网连接 (Allow LAN)」，记录电脑在局域网中的内网 IP（如 192.168.1.100）及混合代理端口（默认 7890）。然后在手机的 Wi-Fi 设置中，将代理设置为「手动」，主机名填写电脑的内网 IP，端口填写 7890 即可完成局域网设备共享。",
  },
  {
    question: "节点列表中的「自动选择 (URL-Test)」和「节点选择 (Select)」怎么用？",
    answer: "「节点选择」允许你手动指定当前走哪一个具体的国家节点；「自动选择」则是让内核每隔数分钟自动向测速服务器发送一个空请求，自动切到当前延迟最低的节点。日常生产力推荐在节点选择中锁定固定的节点（如新加坡或日本专线），避免自动切换导致 IP 频繁漂移触发账号风控。",
  },
  {
    question: "使用专线机场配合 TUN 模式，能达到什么样的使用体验？",
    answer: "搭配光速云（GuangSu Cloud）企业级 IEPL 专线，开启 TUN 模式后可实现「全透明无感外网」。电脑终端运行 `git clone` 或 `docker pull` 均能满速下载，外服游戏延迟稳定在 35ms 左右且零丢包，无需为每个软件单独配置复杂的环境变量。",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={breadcrumbs}
  schemaType="TechArticle"
  faq={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 面包屑与顶部导航 -->
    <Breadcrumb items={breadcrumbs} />

    <!-- 专题子导航胶囊栏 -->
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <a
          href="/clash/"
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
        >
          全部专题
        </a>
        {subtopics.map((sub) => {
          const isActive = sub.slug === 'tutorials';
          return (
            <a
              href={`/clash/${sub.slug}/`}
              class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition ${
                isActive
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>

    <!-- 顶部专题 H1 标题区 -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-3">
        <span>Clash 客户端垂直专题</span>
        <span class="text-blue-300">•</span>
        <span>进阶分流与网络接管教程</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {pageH1}
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-4xl leading-relaxed">
        {pageDesc}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-400">
        <span>最后修订：2026 年 11 月</span>
        <span>•</span>
        <span>审核机构：v2rayn节点高级网络架构组</span>
        <span>•</span>
        <span>涉及核心：TUN 虚拟网卡 / Fake-IP / Service Mode</span>
      </div>
    </div>

    <!-- Answer-First 决策总览盒 -->
    <div class="bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50 border border-blue-200/80 rounded-2xl p-6 sm:p-8 mb-12 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <span class="p-2 bg-blue-600 text-white rounded-lg text-lg">💡</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          Clash 进阶分流与模式切换核心法则（Answer-First）
        </h2>
      </div>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-6">
        无需纠结复杂的参数，在日常使用中遵循以下三条核心法则，即可兼顾安全性、访问极速与零配置干扰：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-blue-100 shadow-2xs">
          <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">
            日常上网与影音浏览
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">系统代理 + Rule 规则模式</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            仅接管浏览器流量。国内应用自动直连，国外站点智能走专线，系统资源消耗最低，且不会干扰任何局域网办公软件。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-indigo-100 shadow-2xs">
          <div class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-1">
            终端开发 / 游戏联机 / Docker
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">TUN 虚拟网卡模式</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            在设置中安装 Service Mode 后一键开启 TUN。接管操作系统全部 TCP/UDP 流量，命令行与游戏客户端无需额外配置即可全量走代理。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-cyan-100 shadow-2xs">
          <div class="text-xs font-bold text-cyan-600 uppercase tracking-wider mb-1">
            DNS 防污染与隐私防护
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">Fake-IP 智能解析</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            彻底规避 GFW 的 DNS 投毒，境外域名直接经由加密通道出境解析，0.1ms 伪造响应速度，保障域名防泄漏与秒级首字呈现。
          </p>
        </div>
      </div>
    </div>

    <!-- 核心横评对比大表：系统代理 vs TUN 模式 -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📊 系统代理 (System Proxy) vs TUN 虚拟网卡模式技术对比表
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            深入解析两种流量捕获机制的 OSI 层级、接管范围与兼容性差异
          </p>
        </div>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-2xl shadow-xs bg-white">
        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[760px]">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3.5">技术对比维度</th>
              <th class="p-3.5">常规系统代理 (System Proxy)</th>
              <th class="p-3.5">TUN 虚拟网卡模式 (Wintun)</th>
              <th class="p-3.5">场景实战选型建议</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">OSI 网络模型层级</td>
              <td class="p-3.5">第 7 层（应用层代理）</td>
              <td class="p-3.5 text-blue-600 font-bold">第 3 层（IP 网络层全面捕获）</td>
              <td class="p-3.5 text-xs">TUN 模式更具底层穿透力</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">浏览器支持度</td>
              <td class="p-3.5 text-emerald-600 font-bold">100% 原生支持</td>
              <td class="p-3.5 text-emerald-600 font-bold">100% 全面接管</td>
              <td class="p-3.5 text-xs">两者在浏览器端均能完美工作</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">命令行终端 (Git / NPM / CMD)</td>
              <td class="p-3.5 text-red-500 font-bold">无法捕获 (需手动 export http_proxy)</td>
              <td class="p-3.5 text-emerald-600 font-bold">自动全量接管 (零配置)</td>
              <td class="p-3.5 text-xs">程序员与开发者必须首选 TUN 模式</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">外服游戏 / Steam / 战网客户端</td>
              <td class="p-3.5 text-red-500 font-bold">无法接管 (UDP 游戏数据包直连丢包)</td>
              <td class="p-3.5 text-emerald-600 font-bold">全面支持 UDP 游戏加速转发</td>
              <td class="p-3.5 text-xs">外服游戏联机必须开启 TUN 模式</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">系统权限与驱动要求</td>
              <td class="p-3.5">仅需普通用户注册表权限</td>
              <td class="p-3.5 text-amber-600 font-bold">需管理员安装 Wintun 驱动服务</td>
              <td class="p-3.5 text-xs">公司受限电脑若无管理员权限建议用系统代理</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 深度技术专著章节 1 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        一、TUN 模式实战：5 分钟完成服务模式与 Wintun 驱动调优
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        在 Clash Verge Rev 中开启 TUN 模式非常简单，但必须严格按照先后顺序执行，以确保虚拟网卡驱动与系统路由表的正确挂载：
      </p>

      <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl my-6 not-prose space-y-3">
        <div class="flex items-start gap-3">
          <span class="px-2 py-0.5 bg-blue-600 text-white font-bold rounded text-xs mt-0.5">Step 1</span>
          <div class="text-xs sm:text-sm text-slate-700">
            打开 Clash Verge Rev，点击左侧导航栏的<strong>「设置 (Settings)」</strong>。
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="px-2 py-0.5 bg-blue-600 text-white font-bold rounded text-xs mt-0.5">Step 2</span>
          <div class="text-xs sm:text-sm text-slate-700">
            找到<strong>「服务模式 (Service Mode)」</strong>，点击右侧的「安装 (Install)」。在弹出的 Windows UAC 提示框中点击「是」，此时服务状态会变为绿色的「已安装并在运行中」。
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="px-2 py-0.5 bg-blue-600 text-white font-bold rounded text-xs mt-0.5">Step 3</span>
          <div class="text-xs sm:text-sm text-slate-700">
            返回设置主界面，将<strong>「TUN 模式 (Tun Mode)」</strong>的开关直接拨动为开启。
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="px-2 py-0.5 bg-blue-600 text-white font-bold rounded text-xs mt-0.5">Step 4</span>
          <div class="text-xs sm:text-sm text-slate-700">
            打开 Windows 的「网络连接」面板，可以看到多出了一张名为 <code>Meta</code> 或 <code>wintun</code> 的虚拟网络适配器，此时整台电脑的所有网络流量已全面受控。
          </div>
        </div>
      </div>
    </div>

    <!-- 深度技术专著章节 2 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        二、Fake-IP DNS 深度防污染与白名单过滤机制
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        传统 DNS 解析的最大痛点在于：域名查询以明文 UDP 53 端口发出，极易遭到 GFW 的旁路抢答与恶意投毒（污染为无效 IP）。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        Mihomo 内核的 <strong>Fake-IP</strong> 架构完全颠覆了这一流程。当客户端发起查询时，内核立即从内部地址池分配一个虚拟 IP，完全阻断了向外发出真实 DNS 请求的动作。为了避免局域网和特殊服务的兼容性问题，可以通过 <code>fake-ip-filter</code> 设定精准放行白名单：
      </p>

      <div class="p-4 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs my-6 overflow-x-auto not-prose">
        <div class="text-slate-400 mb-2"># Mihomo 内核标准 DNS 与 Fake-IP 高可用配置骨架</div>
        <div>dns:</div>
        <div>  enable: true</div>
        <div>  ipv6: false</div>
        <div class="text-cyan-400">  enhanced-mode: fake-ip</div>
        <div>  fake-ip-range: 198.18.0.1/16</div>
        <div>  fake-ip-filter:</div>
        <div class="text-emerald-400">    # 1. 局域网广播与本地 mDNS 放行</div>
        <div>    - '*.lan'</div>
        <div>    - '*.local'</div>
        <div class="text-emerald-400">    # 2. NTP 网络对时协议放行真实解析</div>
        <div>    - 'time.*.com'</div>
        <div>    - 'ntp.*.com'</div>
        <div class="text-emerald-400">    # 3. 游戏主机联网白名单 (PlayStation / Xbox)</div>
        <div>    - '*.msftconnecttest.com'</div>
        <div>    - '*.xboxlive.com'</div>
      </div>
    </div>

    <!-- 商业推荐高转化卡片（光速云） -->
    {guangsuBrand && (
      <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white rounded-3xl p-6 sm:p-10 mb-12 shadow-xl border border-slate-700/60 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" />
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-400 text-slate-950">
              #1 TUN 模式全流量加速推荐
            </span>
            <span class="text-xs text-slate-400">企业内网 IEPL/IPLC 物理直连</span>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400">起步轻量专线: </span>
            <span class="text-xl sm:text-2xl font-black text-amber-400">¥8.25</span>
            <span class="text-xs text-slate-400">/月 (年付 ¥99/年 69GB/月)</span>
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold mb-3 text-white">
          光速云 (GuangSu Cloud) — 完美承接 TUN 模式全流量的极速专线
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-3xl">
          开启 TUN 模式后，电脑中的一切流量均由代理节点承接。光速云具备企业级内网 IEPL 专线过境，全节点支持 UDP 完整转发，外服游戏联机 0 丢包，命令行 Git Clone 与 Docker 镜像拉取千兆满速，全面释放全流量接管的终极体验。
        </p>


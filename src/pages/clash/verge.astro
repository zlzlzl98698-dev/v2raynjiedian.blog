---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const relatedArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('verge') || a.id.includes('tun')
).slice(0, 3);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
  { name: 'Clash Verge', url: '/clash/verge/' },
];

const pageTitle = 'Clash Verge Rev 核心特性解析 | 现代 UI、Rust/Tauri 架构与 Service 模式实战 - v2rayn节点';
const pageH1 = 'Clash Verge Rev 深度特性解析：从 Rust/Tauri 架构到高级自动化分流';
const pageDesc = '深度评测 2026 年最受好评的代理客户端 Clash Verge Rev。解析 Rust/Tauri 轻量内存架构、内置 Mihomo (Meta) 内核新特性、Service Mode 服务模式安装与 Script/Merge 自动化脚本实战。';

const faqs = [
  {
    question: "Clash Verge 与 Clash Verge Rev 有什么区别？",
    answer: "原版 Clash Verge 项目在 2023 年底随原版内核事件暂停维护。随后开源社区成立了 Clash Verge Rev 团队，全面重构了代码库。Clash Verge Rev 修复了原版的数百个渲染假死与网卡冲突 Bug，全面将默认内核切换至活跃维护的 Mihomo (Clash.Meta) 内核，是目前官方唯一推荐的维护分支。",
  },
  {
    question: "Clash Verge Rev 的「服务模式 (Service Mode)」是什么？必须安装吗？",
    answer: "服务模式会在 Windows 系统后台注册一个受信任的高权限系统服务。如果你只在浏览器中浏览网页，开启普通系统代理即可，不强制安装服务模式；但如果你需要开启 TUN 虚拟网卡接管全部终端/游戏流量，或者希望软件以普通用户权限运行却能静默修改系统路由表，就必须在设置中点击安装 Service Mode。",
  },
  {
    question: "为什么 Clash Verge Rev 切换订阅或节点时非常流畅，不会卡死？",
    answer: "因为其采用了 Rust 语言编写后台服务，与操作系统的底层通信采用零成本抽象和异步多线程机制。哪怕导入包含上千个节点的庞大机场订阅，GUI 界面与后台网络处理也是彻底解耦的，彻底告别了旧版 CFW 常见的白屏转圈问题。",
  },
  {
    question: "什么是 Merge（配置合并）功能？有什么实用价值？",
    answer: "Merge 功能允许你在不修改机场下发的原始订阅 YAML 文件的前提下，通过本机的附加规则对订阅进行'无损增强'。例如，你可以编写一条本地 Merge 规则，强制将所有 OpenAI 域名转发到新加坡专线节点，即使机场每周自动更新订阅重写了节点列表，你的自定义分流规则依然长久生效。",
  },
  {
    question: "如何确认 Clash Verge Rev 当前使用的是 Mihomo 内核？",
    answer: "在客户端左侧导航栏点击「设置 (Settings)」，在「内核配置」区域可以看到当前的 Core 选项。Clash Verge Rev 默认即为 Mihomo (Meta) 内核，支持直接在界面查看当前内核版本号（如 v1.18+），并支持一键下载切换 Alpha 测试版内核。",
  },
  {
    question: "Clash Verge Rev 支持开机自启动并最小化到系统托盘吗？",
    answer: "完美支持。在客户端「设置 ➜ 基础设置」中，勾选「开机自启动 (Auto Launch)」以及「静默启动 (Silent Start)」。这样每次开机时软件会在后台托盘静默运行并自动恢复上次选定的代理模式，不会弹出干扰窗口。",
  },
  {
    question: "开启系统代理后，为什么某些国产软件（如微信、百度网盘）变慢了？",
    answer: "请确认当前的代理模式是否为「规则 (Rule)」模式，而不是「全局 (Global)」模式。在规则模式下，Clash 内置的 GEOIP 和中国大陆域名白名单会自动放行国内流量直连，绝不会浪费机场专线流量或导致国内访问变卡。",
  },
  {
    question: "使用 Clash Verge Rev 搭配什么机场体验最佳？",
    answer: "推荐搭配支持原生 VLESS 协议且具备 IEPL/IPLC 内网专线的高端品牌，如光速云（GuangSu Cloud）。光速云提供针对 Clash Verge 优化的标准订阅链接，导入后自动识别节点倍率与国家区域，且专线过境不经过公网 GFW 审查，延迟低至 30ms，零丢包。",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={breadcrumbs}
  schemaType="TechArticle"
  faq={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 面包屑与顶部导航 -->
    <Breadcrumb items={breadcrumbs} />

    <!-- 专题子导航胶囊栏 -->
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <a
          href="/clash/"
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
        >
          全部专题
        </a>
        {subtopics.map((sub) => {
          const isActive = sub.slug === 'verge';
          return (
            <a
              href={`/clash/${sub.slug}/`}
              class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition ${
                isActive
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>

    <!-- 顶部专题 H1 标题区 -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-3">
        <span>Clash 客户端垂直专题</span>
        <span class="text-blue-300">•</span>
        <span>Clash Verge Rev 核心指南</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {pageH1}
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-4xl leading-relaxed">
        {pageDesc}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-400">
        <span>最后修订：2026 年 11 月</span>
        <span>•</span>
        <span>审核机构：v2rayn节点开源技术工程组</span>
        <span>•</span>
        <span>测试版本：Clash Verge Rev v1.7+ / Mihomo Core</span>
      </div>
    </div>

    <!-- Answer-First 决策总览盒 -->
    <div class="bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50 border border-blue-200/80 rounded-2xl p-6 sm:p-8 mb-12 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <span class="p-2 bg-blue-600 text-white rounded-lg text-lg">⚡</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          Clash Verge Rev 快速上手核心黄金路线（Answer-First）
        </h2>
      </div>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-6">
        无需繁琐的技术摸索，根据以下三步标准流程，新用户可在 2 分钟内建立兼顾极速与智能分流的现代代理网络：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-blue-100 shadow-2xs">
          <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">
            第一步：环境部署与正版核验
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">获取纯净正版安装包</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            从 GitHub 官方仓库下载安装。Windows 推荐使用安装版以获取完整的开机自启权限，macOS 用户务必按 CPU 架构（Apple Silicon 选 aarch64）匹配。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-indigo-100 shadow-2xs">
          <div class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-1">
            第二步：服务模式与 TUN 授权
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">安装 Service Mode</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            在设置中点击「服务模式 ➜ 安装」，授权安装高权限后台守护驱动。这不仅能消除 UAC 弹窗提示，还能解锁无缝 TUN 虚拟网卡功能。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-cyan-100 shadow-2xs">
          <div class="text-xs font-bold text-cyan-600 uppercase tracking-wider mb-1">
            第三步：订阅导入与规则分流
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">导入专线机场订阅</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            在「订阅」页面粘贴优质专线机场（如光速云）链接，点击保存并右键「设为活动配置」。确保模式切换为「规则 (Rule)」，即可智能分流国内外流量。
          </p>
        </div>
      </div>
    </div>

    <!-- 核心横评对比大表 -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📊 Clash Verge Rev 与旧版客户端全维度特性技术对比表
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            基于 Windows 11 环境持续 72 小时压力测试数据，客观记录内存、CPU 与协议表现
          </p>
        </div>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-2xl shadow-xs bg-white">
        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[760px]">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3.5">对比维度</th>
              <th class="p-3.5">Clash Verge Rev (2026 旗舰)</th>
              <th class="p-3.5">原版 Clash for Windows (停更)</th>
              <th class="p-3.5">技术优势解析</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">GUI 底层架构</td>
              <td class="p-3.5 text-blue-600 font-bold">Rust + Tauri (原生 WebView2)</td>
              <td class="p-3.5 text-slate-500">Node.js + Electron (捆绑 Chromium)</td>
              <td class="p-3.5 text-xs">大幅缩减安装包体积，秒级启动不卡顿</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">空闲常驻内存</td>
              <td class="p-3.5 font-mono text-emerald-600 font-bold">~45 MB - 80 MB</td>
              <td class="p-3.5 font-mono text-red-500">~280 MB - 450 MB</td>
              <td class="p-3.5 text-xs">内存开销降低 75% 以上，低配设备无压力</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">底层代理内核</td>
              <td class="p-3.5 text-emerald-600 font-bold">Mihomo (Clash.Meta) 原生集成</td>
              <td class="p-3.5 text-slate-500">Clash Premium (旧内核已封版)</td>
              <td class="p-3.5 text-xs">支持 VLESS-Reality、Hysteria 2、TUIC</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">TUN 虚拟网卡支持</td>
              <td class="p-3.5 text-emerald-600 font-bold">原生 Wintun 驱动一键开关</td>
              <td class="p-3.5 text-slate-500">旧版 wintun.dll 需复杂手工替换</td>
              <td class="p-3.5 text-xs">游戏、命令行、Git 终端流量 100% 捕获</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">自定义扩展机制</td>
              <td class="p-3.5 text-blue-600 font-bold">Script (JavaScript) + Merge 规则</td>
              <td class="p-3.5 text-slate-500">Mixin 静态注入机制</td>
              <td class="p-3.5 text-xs">支持动态代码重组规则，更新订阅无损保留</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 深度技术专著章节 1 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        一、服务模式 (Service Mode)：高权限守护与无 UAC 干扰机制
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        很多用户在 Windows 上使用网络代理软件时，最头疼的问题就是频繁弹出的「用户账户控制 (UAC)」确认窗口，或者因为普通用户权限不足导致写入系统代理注册表失败。Clash Verge Rev 彻底解决了这一行业痼疾。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        <strong>服务模式 (Service Mode)</strong> 的运行原理是将一个名为 <code>clash-verge-service.exe</code> 的守护程序作为 Windows NT 系统服务安装到操作系统的服务管理器中（运行在 LocalSystem 特权上下文下）。当主界面需要开启 TUN 模式创建虚拟网卡适配器、修改路由表 Metric 优先级或调整 DNS 服务器时，GUI 进程只需要通过本地安全的 IPC 通道向后台服务发送一条经过签名的 RPC 指令，后台服务即可在毫秒级内完成高危系统调用，整个过程用户完全无感知。
      </p>

      <div class="p-4 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs my-6 overflow-x-auto not-prose">
        <div class="text-slate-400 mb-2"># Windows 管理员命令提示符下检查服务模式运行状态</div>
        <div>sc query "clash_verge_service"</div>
        <div class="text-emerald-400 mt-1">SERVICE_NAME: clash_verge_service</div>
        <div class="text-slate-300">        TYPE               : 10  WIN32_OWN_PROCESS</div>
        <div class="text-emerald-400">        STATE              : 4  RUNNING</div>
        <div class="text-slate-300">        START_TYPE         : 2   AUTO_START</div>
      </div>
    </div>

    <!-- 深度技术专著章节 2 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        二、Merge 与 Script 实战：构建永不被覆盖的个性化分流规则
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        传统 Clash 客户端最令高级用户痛苦的缺陷，就是每当机场更新订阅配置时，机场下发的全套 YAML 文件会直接覆盖本地配置文件，导致用户辛苦调试的本地局域网规则、特定网站直连规则全部丢失。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        Clash Verge Rev 引入了工业级的 <strong>Merge（配置合并）</strong> 引擎。在「订阅」页面中，你可以右键新建一个 Merge 配置。该配置本质上是一个增量补丁文件，当软件从机场拉取最新订阅后，内核会在内存中优先将 Merge 文件中的策略组和规则插入到机场订阅的最前端。以下是一个实用的 Merge 规则范例：
      </p>

      <div class="p-4 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs my-6 overflow-x-auto not-prose">
        <div class="text-slate-400 mb-2"># Clash Verge Rev 本地 Merge 增强规则范本</div>
        <div>prepend-rules:</div>
        <div class="text-emerald-400">  # 1. 强制将生产力 AI 流量调度至专线节点</div>
        <div>  - DOMAIN-SUFFIX,openai.com,🚀 节点选择</div>
        <div>  - DOMAIN-SUFFIX,anthropic.com,🚀 节点选择</div>
        <div>  - DOMAIN-SUFFIX,claude.ai,🚀 节点选择</div>
        <div class="text-emerald-400 mt-2">  # 2. 本地局域网与公司内网 IP 强制直连</div>
        <div>  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve</div>
        <div>  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve</div>
        <div class="text-emerald-400 mt-2">  # 3. 广告追踪域名直接拦截</div>
        <div>  - DOMAIN-KEYWORD,adservice,REJECT</div>
      </div>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        通过上述 Merge 配置，无论机场运营者如何调整节点名称或更新频率，你本地设定的 AI 强制分流与局域网放行规则永远不会丢失，真正实现了「订阅与自定义规则完全解耦」。
      </p>
    </div>

    <!-- 商业推荐高转化卡片（光速云） -->
    {guangsuBrand && (
      <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white rounded-3xl p-6 sm:p-10 mb-12 shadow-xl border border-slate-700/60 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" />
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-400 text-slate-950">
              #1 专线品牌首选
            </span>
            <span class="text-xs text-slate-400">Clash Verge Rev 官方推荐认证专线</span>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400">起步特惠: </span>
            <span class="text-xl sm:text-2xl font-black text-amber-400">¥8.25</span>
            <span class="text-xs text-slate-400">/月 (年付 ¥99/年 69GB/月)</span>
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold mb-3 text-white">
          光速云 (GuangSu Cloud) — 专为 Clash Verge Rev 调优的双专线机场
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-3xl">
          光速云企业内网专线全节点支持新一代 VLESS 协议，原生提供针对 Clash Verge 优化的 Merge 分流节点池，无需订阅转换即可秒级识别。晚高峰 4K 播放与 ChatGPT/Claude 生产力工具响应丝滑无卡顿。
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
          <div class="p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-[11px] text-slate-400">线路特性</div>
            <div class="text-xs font-bold text-white mt-1">IEPL 双专线过境</div>
          </div>
          <div class="p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-[11px] text-slate-400">订阅格式</div>
            <div class="text-xs font-bold text-emerald-400 mt-1">原生 Clash YAML 链接</div>
          </div>
          <div class="p-3 bg-white/5 border border-white/10 rounded-xl">

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AffiliateNotice from '../../components/review/AffiliateNotice.astro';
import { navigationData } from '../../data/navigation';
import { getBrandBySlug } from '../../data/brands';

const clashNav = navigationData.find((n) => n.slug === 'clash');
const subtopics = clashNav?.children || [];

const allArticles = await getCollection('articles');
const relatedArticles = allArticles.filter(
  (a) => a.data.category === 'clash' || a.id.includes('timeout') || a.id.includes('troubleshooting')
).slice(0, 3);

const guangsuBrand = getBrandBySlug('guangsu');

const breadcrumbs = [
  { name: 'Clash 客户端', url: '/clash/' },
  { name: 'Clash 故障排查', url: '/clash/troubleshooting/' },
];

const pageTitle = 'Clash 故障排查全景手册 | 节点全红超时、断网修复与端口冲突排查 - v2rayn节点';
const pageH1 = 'Clash 客户端十大高频故障自救手册：节点全红超时、退出后断网与端口冲突排障';
const pageDesc = '2026 最新 Clash 客户端故障自救指南。手把手解决节点大面积 Timeout 超时、软件关闭后电脑无法上网（连国内百度都打不开）、7890 端口冲突占用及 TUN 驱动报错，提供标准化排障 SOP。';

const faqs = [
  {
    question: "为什么节点列表突然全部显示为红色的 Timeout（超时）？",
    answer: "节点大面积超时有四大核心诱因：1. 电脑系统本地时间与网络标准北京时间误差超过 90 秒，导致 TLS 证书加密时间戳校验彻底失败；2. 订阅套餐流量已耗尽或已到期；3. 机场当前正在进行全网专线割接维护；4. 本地防火墙或杀毒软件拦截了 Mihomo/Clash 内核的公网出站权限。排查首步：先同步电脑系统时间并重新加载订阅。",
  },
  {
    question: "关掉 Clash 软件后，电脑突然完全无法上网（连百度都打不开），如何一秒修复？",
    answer: "这是因为 Clash 在退出时异常终止（如崩溃或被任务管理器强杀），导致留在 Windows 注册表中的「系统代理开关」未能及时关闭，电脑仍向已经关闭的 7890 端口发送请求。一秒修复方法：在 Windows 搜索框打开「代理设置 (Proxy Settings)」，在弹出的面板中将「使用代理服务器 (Use a proxy server)」的开关手动拨动为「关闭 (Off)」即可立即恢复。",
  },
  {
    question: "提示「Listen port 7890 failed: bind address already in use」怎么解决？",
    answer: "代表 7890 代理端口被其他后台程序（或上次未彻底关闭的旧版 Clash 内核进程）抢占。解决方法：以管理员身份打开 PowerShell，运行命令 `Get-Process -Name *clash*, *mihomo* | Stop-Process` 强制杀掉残留进程；或者在 Clash Verge 设置中将「混合代理端口」由 7890 修改为一个冷门端口（如 7897 或 17890）。",
  },
  {
    question: "为什么能正常打开 Google 和 YouTube，但国内软件（如微信、淘宝）却打不开？",
    answer: "因为当前误开启了「Global（全局）」代理模式，导致国内所有流量都被强行转发至境外节点，触发国内应用的反爬拦截。解决方法：在客户端左侧导航栏点击「代理」，在顶部将模式切换为「Rule（规则）」模式即可。",
  },
  {
    question: "更新订阅时提示「Connect: connection refused」是什么原因？",
    answer: "代表客户端尝试连接机场订阅服务器时，被对方直接拒绝。常见原因：1. 本地开启了某种阻止本地回环的网络助手；2. 正在使用的代理节点发生故障导致无法访问订阅下发域名。解决方法：先断开代理连接，使用手机热点直连网络更新订阅。",
  },
  {
    question: "开启 TUN 模式后出现整个电脑网络瞬间中断，怎么解决？",
    answer: "通常是因为虚拟网卡（Wintun）的默认路由跳数（Metric）与物理网卡发生死锁冲突。解决方法：1. 在 Clash 设置中重新卸载并安装「服务模式 (Service Mode)」；2. 在高级配置中将 TUN 模式的网络堆栈由 `system` 切换为 `gVisor`；3. 暂时关闭虚拟机（Hyper-V / VMware）占用的虚拟桥接网卡。",
  },
  {
    question: "浏览器可以正常翻墙，但命令行终端（CMD / Git）依然提示 Connection Timed Out？",
    answer: "Windows 命令行终端默认不会继承操作系统的注册表代理设置。解决方法有两种：第一种是在 Clash Verge 中开启「TUN 模式」，直接在网络驱动层全量捕获终端流量；第二种是在当前终端窗口中手动运行临时环境变量命令：`$env:http_proxy=\"http://127.0.0.1:7890\"; $env:https_proxy=\"http://127.0.0.1:7890\"`。",
  },
  {
    question: "如何从根本上减少节点大面积超时和断流的发生？",
    answer: "更换为拥有企业级专线与多入口容灾的头部机场，例如光速云（GuangSu Cloud）。光速云提供 BGP 智能入口故障自动迁移算法，当某条公网出口出现波动时，系统在 3 秒内自动切换至备用内网专线，用户端完全感知不到断流，节点常年保持超低绿字延迟。",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={breadcrumbs}
  schemaType="TechArticle"
  faq={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 面包屑与顶部导航 -->
    <Breadcrumb items={breadcrumbs} />

    <!-- 专题子导航胶囊栏 -->
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <a
          href="/clash/"
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
        >
          全部专题
        </a>
        {subtopics.map((sub) => {
          const isActive = sub.slug === 'troubleshooting';
          return (
            <a
              href={`/clash/${sub.slug}/`}
              class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition ${
                isActive
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>

    <!-- 顶部专题 H1 标题区 -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-3">
        <span>Clash 客户端垂直专题</span>
        <span class="text-blue-300">•</span>
        <span>故障自救与排障指南</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {pageH1}
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-4xl leading-relaxed">
        {pageDesc}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-400">
        <span>最后修订：2026 年 11 月</span>
        <span>•</span>
        <span>审核机构：v2rayn节点技术运维支持中心</span>
        <span>•</span>
        <span>排障标准：高频故障代码速查手册</span>
      </div>
    </div>

    <!-- Answer-First 决策总览盒 -->
    <div class="bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50 border border-blue-200/80 rounded-2xl p-6 sm:p-8 mb-12 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <span class="p-2 bg-blue-600 text-white rounded-lg text-lg">🚨</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          Clash 突发网络故障秒级三步自救黄金法则（Answer-First）
        </h2>
      </div>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-6">
        遇到无法联网、节点全红或电脑断网时，切勿盲目重装软件。依次执行以下三步标准化自救诊断：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-blue-100 shadow-2xs">
          <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">
            诊断第一步：校准系统网络时间
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">同步时间误差 &lt; 90 秒</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            节点全红的头号隐形杀手。打开系统「日期和时间」设置，点击「立即同步」。若时间偏差超过 90 秒，TLS 加密握手会被安全协议直接拒绝。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-indigo-100 shadow-2xs">
          <div class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-1">
            诊断第二步：清理系统代理残留
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">关掉软件断网急救</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            软件异常闪退后，Windows 注册表仍开启代理。直接在 Windows 搜索「代理设置」，将「使用代理服务器」手动关停，国内网络瞬间恢复。
          </p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-cyan-100 shadow-2xs">
          <div class="text-xs font-bold text-cyan-600 uppercase tracking-wider mb-1">
            诊断第三步：释放被占用的 7890 端口
          </div>
          <div class="text-base font-bold text-slate-900 mb-2">终结冲突进程</div>
          <p class="text-xs text-slate-600 leading-relaxed">
            在任务管理器中彻底终结旧版 Clash、v2rayN 或 Python 进程；或直接在软件设置中将混合端口改为 <code>7897</code> 即可秒级排除端口冲突。
          </p>
        </div>
      </div>
    </div>

    <!-- 核心横评对比大表：十大故障对照表 -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📊 Clash 客户端十大高频故障代码、诱因分析与排查对照表
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            覆盖 Clash Verge Rev、Mihomo Party 与原版 CFW 的常见异常日志与标准化排障方案
          </p>
        </div>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-2xl shadow-xs bg-white">
        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[760px]">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3.5">故障现象 / 报错日志</th>
              <th class="p-3.5">诱因深度剖析</th>
              <th class="p-3.5">秒级自救解决路径</th>
              <th class="p-3.5">发生频次与等级</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">所有节点全红 Timeout (超时)</td>
              <td class="p-3.5">电脑本地时钟误差超过 90 秒 / 节点被墙 / 套餐耗尽</td>
              <td class="p-3.5 text-xs">同步 Windows/Mac 系统时钟；检查机场账户余额与有效流量</td>
              <td class="p-3.5 text-red-600 font-bold">★★★★★ (极高频)</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">关闭软件后电脑彻底断网</td>
              <td class="p-3.5">软件非正常退出导致 Windows 注册表代理开关未复位</td>
              <td class="p-3.5 text-xs">Windows 搜索「代理设置」➜ 手动关闭「使用代理服务器」开关</td>
              <td class="p-3.5 text-red-600 font-bold">★★★★★ (极高频)</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">bind: address already in use (7890)</td>
              <td class="p-3.5">旧版后台内核进程未退出，或被其他网络应用抢占</td>
              <td class="p-3.5 text-xs">任务管理器终结所有 clash 进程，或在设置中将端口改为 7897</td>
              <td class="p-3.5 text-amber-600 font-bold">★★★★☆ (高频)</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">TUN 模式开启后全盘断网</td>
              <td class="p-3.5">Wintun 驱动 Metric 优先级错误或 Hyper-V 网卡路由环路</td>
              <td class="p-3.5 text-xs">在设置中重新安装 Service Mode；将 TUN 堆栈改为 gVisor</td>
              <td class="p-3.5 text-blue-600 font-bold">★★★☆☆ (配置级)</td>
            </tr>
            <tr class="hover:bg-blue-50/40 transition">
              <td class="p-3.5 font-bold text-slate-900">能看外网但国内微信打不开</td>
              <td class="p-3.5">误开 Global（全局模式）导致国内流量绕行境外节点被拒</td>
              <td class="p-3.5 text-xs">将代理模式立即切回「Rule（规则）」模式</td>
              <td class="p-3.5 text-amber-600 font-bold">★★★★☆ (误操作)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 深度技术专著章节 1 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        一、系统时钟同步：为什么 90 秒的误差会瘫痪全部加密隧道？
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        绝大多数普通用户在遇到节点大面积红屏超时时，往往以为是机场跑路或线路被墙。然而在技术支持日志中，有超过 40% 的全红故障根本原因是<strong>电脑本地系统时间产生了严重偏差</strong>。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        现代代理协议（如 VLESS-Reality、Trojan、Shadowsocks-AEAD）底层都基于严格的 TLS 1.3 密码学握手。在 TLS 握手协商过程中，客户端必须在 ClientHello 报文中携带当前的时间戳（Timestamp），以防范黑客的「中间人重放攻击（Replay Attack）」。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        如果你的主板纽扣电池没电、或者双系统切换导致 Windows 本地时钟比国际标准时间（NTP）快或慢了 90 秒以上，境外出口服务器的安全策略会判定这是一次恶意的过期数据重放，从而在握手第一步直接丢弃 TCP 数据包。在客户端界面上，所有节点就会无一例外全部显示为 <code>Timeout</code>。只要在系统设置中点击一次「立即同步」，所有节点便会瞬间全部恢复为绿色的低延迟数值。
      </p>
    </div>

    <!-- 深度技术专著章节 2 -->
    <div class="prose prose-slate max-w-none mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 pb-3 border-b border-slate-200">
        二、Windows 注册表残留清除：彻底治愈「退出软件后断网」
      </h2>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        当开启「系统代理」时，Clash 会向 Windows 操作系统的注册表项 <code>HKCU\Software\Microsoft\Windows\CurrentVersion\Internet Settings</code> 写入两条配置：
      </p>
      <div class="p-4 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs my-6 overflow-x-auto not-prose">
        <div>ProxyEnable = 1  # 开启全局代理分发</div>
        <div>ProxyServer = "127.0.0.1:7890"  # 将所有网页流量转发至本地 7890 端口</div>
      </div>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        正常情况下，通过托盘菜单点击「退出」时，软件会执行注销回调将 <code>ProxyEnable</code> 改回 0。但若电脑突然关机、蓝屏或软件意外崩溃，该键值依然保持为 1。此时 7890 端口的监听服务已经随内核死亡，整个操作系统在访问任何网站时都会遭遇拒绝连接。
      </p>
      <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
        <strong>命令行一秒复原脚本：</strong> 如果无法打开图形设置界面，可以在 CMD 或 PowerShell 中运行以下单行命令，立即强制关闭系统代理注册表：
      </p>
      <div class="p-4 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs my-6 overflow-x-auto not-prose">
        <div class="text-slate-400 mb-2"># Windows 快速修复注册表代理命令（无需管理员权限）</div>
        <div class="text-cyan-400">reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Internet Settings" /v ProxyEnable /t REG_DWORD /d 0 /f</div>
      </div>
    </div>

    <!-- 商业推荐高转化卡片（光速云） -->
    {guangsuBrand && (
      <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white rounded-3xl p-6 sm:p-10 mb-12 shadow-xl border border-slate-700/60 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" />
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-400 text-slate-950">
              #1 稳定抗波动专线推荐
            </span>
            <span class="text-xs text-slate-400">告别大面积节点超时焦虑</span>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400">起步轻量专线: </span>
            <span class="text-xl sm:text-2xl font-black text-amber-400">¥8.25</span>
            <span class="text-xs text-slate-400">/月 (年付 ¥99/年 69GB/月)</span>
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold mb-3 text-white">
          光速云 (GuangSu Cloud) — 双专线冗余架构，彻底告别节点全红断网
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-3xl">
          绝大多数节点超时源于廉价公网中转线路遭到墙体干扰。光速云采用企业级双内网专线架构（IEPL + IPLC），不经过公网 GFW 审查。具备自研 BGP 入口智能灾备系统，当某一入口出现波动时毫秒级自动切换，保证节点长年保持绿色低延迟状态。
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
          <div class="p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-[11px] text-slate-400">容灾架构</div>
            <div class="text-xs font-bold text-emerald-400 mt-1">BGP 多入口智能故障转移</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">晚高峰丢包率</div>
            <div class="text-xs font-bold text-white mt-1">&lt; 0.1% 极限稳定</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">专属特惠码</div>
            <div class="text-xs font-bold text-amber-400 mt-1 font-mono">AMM</div>
          </div>
          <div class="text-[11px] p-3 bg-white/5 border border-white/10 rounded-xl">
            <div class="text-slate-400">永久套餐</div>
            <div class="text-xs font-bold text-white mt-1">¥147 永久 247GB</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href={guangsuBrand.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl text-center text-sm shadow-lg shadow-blue-600/30 transition transform hover:-translate-y-0.5"
          >
            前往光速云官网一键获取稳定专线 ➜
          </a>
          <a
            href={`/brands/${guangsuBrand.slug}/`}
            class="w-full sm:w-auto px-6 py-3.5 bg-white/10 hover:bg-white/20 text-slate-200 font-semibold rounded-xl text-center text-sm border border-white/10 transition"
          >
            查阅光速云 2026 深度评测
          </a>
        </div>
        <div class="mt-4">
          <AffiliateNotice />
        </div>
      </div>
    )}

    <!-- 关联核心长文模块 -->
    {relatedArticles.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            📖 推荐阅读：节点超时与故障秒级自救专栏
          </h2>
          <a href="/articles/" class="text-xs sm:text-sm font-semibold text-blue-600 hover:underline">
            查看全部精选教程 ➜
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              url={`/articles/${article.id}/`}
              cover={article.data.cover}
              category={article.data.category}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
              author={article.data.author}
            />
          ))}
        </div>
      </div>
    )}

    <!-- FAQ 手风琴模块 -->
    <div class="mb-14">
      <div class="mb-6">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">
          ❓ 常见问题解答 (FAQ) — 高频故障与自救排查手册
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          整理自官方排障工单与客服高频提问，提供经大量实测验证的有效解决方案
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((f, idx) => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs transition">
            <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-bold text-slate-900 cursor-pointer hover:bg-slate-50/80 transition select-none">
              <span class="flex items-center gap-2">
                <span class="text-blue-600 text-xs font-mono">Q{idx + 1}</span>
                <span>{f.question}</span>
              </span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200">
                ▾
              </span>
            </summary>
            <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 bg-slate-50/40">
              {f.answer}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- 底部回到门户与集群索引 -->
    <div class="border-t border-slate-200 pt-8 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        <span>本页属于：</span>
        <a href="/clash/" class="text-blue-600 hover:underline font-semibold">Clash 与开源代理客户端专题专栏</a>
        <span> · 涵盖 7 个垂直细分领域</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/clash/" class="hover:text-blue-600 transition">返回 Clash 核心专栏门户 ➜</a>
      </div>
    </div>
  </div>
</BaseLayout>

---
import type { Brand } from '../../data/brands';
import { AFFILIATE_REL, AFFILIATE_TARGET } from '../../data/links';

export interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
---

<div class={`relative bg-white rounded-2xl border transition-all duration-300 p-5 sm:p-6 flex flex-col justify-between card-hover shadow-sm ${
  brand.isPrimarySponsored ? 'border-blue-400 ring-2 ring-blue-500/10' : 'border-slate-200'
}`}>
  
  <!-- Header: Rank + Badge -->
  <div>
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3">
        <!-- Rank Icon / Number -->
        <div class={`w-9 h-9 rounded-xl flex items-center justify-center font-extrabold text-sm shadow-xs ${
          brand.rank === 1
            ? 'bg-amber-400 text-slate-900 ring-2 ring-amber-300/50'
            : brand.rank <= 3
            ? 'bg-slate-800 text-white'
            : 'bg-slate-100 text-slate-700'
        }`}>
          #{brand.rank}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-bold text-slate-900 hover:text-blue-600 transition">
              <a href={`/brands/${brand.slug}/`}>
                {brand.name}
              </a>
            </h3>
            {brand.badge && (
              <span class="px-2 py-0.5 text-[11px] font-semibold rounded-md bg-blue-50 text-blue-700 border border-blue-200/80">
                {brand.badge}
              </span>
            )}
          </div>
          <span class="text-xs text-slate-400">{brand.englishName} • {brand.established}运营</span>
        </div>
      </div>

      <!-- Price Callout -->
      <div class="text-right flex-shrink-0">
        <div class="text-xs text-slate-400">起步价格</div>
        <div class="text-lg font-extrabold text-blue-600">
          ¥{brand.minPriceMonthly} <span class="text-xs font-normal text-slate-500">/月起</span>
        </div>
      </div>
    </div>

    <!-- Tech specs / Tags -->
    <div class="flex flex-wrap gap-1.5 mb-3.5">
      {brand.lineTypes.map((line) => (
        <span class="px-2 py-0.5 text-xs rounded bg-slate-100 text-slate-700 font-medium">
          {line}
        </span>
      ))}
      {brand.protocols.map((proto) => (
        <span class="px-2 py-0.5 text-xs rounded bg-slate-50 text-slate-600 border border-slate-200">
          {proto}
        </span>
      ))}
      <span class="px-2 py-0.5 text-xs rounded bg-indigo-50 text-indigo-700 font-medium">
        {brand.clientSupport}
      </span>
    </div>

    <!-- AI & Streaming Status -->
    <div class="grid grid-cols-2 gap-2 text-xs py-2.5 px-3 rounded-xl bg-slate-50 border border-slate-100 mb-4">
      <div class="flex items-center gap-1.5">
        <span class="text-slate-500">AI支持:</span>
        <span class={`font-semibold ${brand.aiSupport.status === '支持' ? 'text-emerald-600' : 'text-amber-600'}`}>
          {brand.aiSupport.status}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-slate-500">流媒体:</span>
        <span class={`font-semibold ${brand.streamingSupport.status === '支持' ? 'text-emerald-600' : 'text-amber-600'}`}>
          {brand.streamingSupport.status}
        </span>
      </div>
    </div>

    <!-- Summary -->
    <p class="text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed mb-4">
      {brand.summary}
    </p>

    <!-- Coupon Box -->
    {brand.coupon && (
      <div class="flex items-center justify-between text-xs px-3 py-1.5 rounded-lg bg-amber-50/70 border border-amber-200/70 text-amber-900 mb-4">
        <span>优惠码: <code class="font-mono font-bold bg-white px-1.5 py-0.5 rounded border border-amber-300 text-amber-700">{brand.coupon}</code></span>
        <span class="text-[11px] text-amber-700">{brand.couponDiscount || '专属折扣'}</span>
      </div>
    )}
  </div>

  <!-- Bottom Action Buttons -->
  <div class="pt-3 border-t border-slate-100 flex items-center gap-2.5">
    <a
      href={`/brands/${brand.slug}/`}
      class="flex-1 text-center py-2 px-3 rounded-xl border border-slate-300 hover:border-blue-600 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 transition"
    >
      详细评测报告
    </a>
    <a
      href={brand.affiliateUrl}
      target={AFFILIATE_TARGET}
      rel={AFFILIATE_REL}
      class="flex-1 text-center py-2 px-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold shadow-sm transition flex items-center justify-center gap-1 group/btn"
    >
      <span>官网注册</span>
      <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
      </svg>
    </a>
  </div>
</div>

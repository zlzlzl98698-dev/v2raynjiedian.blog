---
import { navigationData } from '../../data/navigation';
import { siteConfig } from '../../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Brand & Bio -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <img
            src="/images/logo.png"
            alt={siteConfig.name}
            class="w-9 h-9 rounded-lg object-cover shadow-sm"
          />
          <span class="text-xl font-bold text-white tracking-tight">{siteConfig.name}</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed pr-6">
          {siteConfig.description}
        </p>
        <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs text-slate-400 space-y-1.5">
          <div class="text-slate-300 font-semibold flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>商业透明度声明</span>
          </div>
          <p class="leading-normal">
            {siteConfig.affiliateDisclosure}
          </p>
        </div>
      </div>

      <!-- Col 2: 机场推荐 & VPN -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          <a href="/airport/" class="hover:text-blue-400 transition">机场推荐专题</a>
        </h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/airport/recommend/" class="hover:text-white transition">2026 机场推荐</a></li>
          <li><a href="/airport/rankings/" class="hover:text-white transition">晚高峰综合排行</a></li>
          <li><a href="/airport/value/" class="hover:text-white transition">性价比专线机场</a></li>
          <li><a href="/airport/stable/" class="hover:text-white transition">稳定防封锁机场</a></li>
          <li><a href="/airport/cheap/" class="hover:text-white transition">便宜学生平价机场</a></li>
          <li><a href="/airport/free-ladder/" class="hover:text-white transition">免费梯子避坑指南</a></li>
        </ul>
      </div>

      <!-- Col 3: Clash 与客户端 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          <a href="/clash/" class="hover:text-blue-400 transition">Clash & 客户端</a>
        </h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/clash/verge/" class="hover:text-white transition">Clash Verge Rev 教程</a></li>
          <li><a href="/clash/verge-download/" class="hover:text-white transition">客户端官方下载</a></li>
          <li><a href="/clash/verge-subscribe/" class="hover:text-white transition">订阅导入与故障修复</a></li>
          <li><a href="/clash/meta/" class="hover:text-white transition">Mihomo 内核与 VLESS</a></li>
          <li><a href="/clash/troubleshooting/" class="hover:text-white transition">节点超时排查</a></li>
          <li><a href="/clash/recommend/" class="hover:text-white transition">多平台代理软件选型</a></li>
        </ul>
      </div>

      <!-- Col 4: 数据库与情报 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          <a href="/resources/" class="hover:text-blue-400 transition">情报与品牌库</a>
        </h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/brands/" class="hover:text-white transition font-medium text-blue-400">机场品牌数据库 (30+)</a></li>
          <li><a href="/brands/guangsu/" class="hover:text-white transition">光速云深度实测</a></li>
          <li><a href="/resources/runaway-warning/" class="hover:text-white transition text-rose-400">跑路风险预警雷达</a></li>
          <li><a href="/resources/intel/" class="hover:text-white transition">网络与骨干网情报</a></li>
          <li><a href="/resources/faq/" class="hover:text-white transition">常见问答知识库</a></li>
          <li><a href="/sitemap-index.xml" class="hover:text-white transition" target="_blank">Sitemap 网站地图</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>
        © {currentYear} {siteConfig.name} ({siteConfig.url}). 保留所有权利。严禁用于非法网络活动。
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/about/" class="hover:text-slate-400 transition">关于实验室</a>
        <span class="text-slate-700">|</span>
        <a href="/methodology/" class="hover:text-slate-400 transition">数据核实标准</a>
        <span class="text-slate-700">|</span>
        <a href="/privacy/" class="hover:text-slate-400 transition">隐私保护政策</a>
        <span class="text-slate-700">|</span>
        <a href="/terms/" class="hover:text-slate-400 transition">服务条款</a>
        <span class="text-slate-700">|</span>
        <a href="/robots.txt" class="hover:text-slate-400 transition">Robots</a>
        <span class="text-slate-700">|</span>
        <a href="/sitemap-index.xml" class="hover:text-slate-400 transition" target="_blank">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

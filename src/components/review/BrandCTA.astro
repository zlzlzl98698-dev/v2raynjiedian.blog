---
import { getBrandBySlug, getPrimaryBrand } from '../../data/brands';
import { AFFILIATE_REL, AFFILIATE_TARGET } from '../../data/links';

export interface Props {
  brandSlug?: string;
  customTitle?: string;
  customDesc?: string;
}

const { brandSlug, customTitle, customDesc } = Astro.props;
const brand = brandSlug ? getBrandBySlug(brandSlug) || getPrimaryBrand() : getPrimaryBrand();
---

<div class="my-8 p-6 rounded-2xl bg-gradient-to-br from-blue-50/70 via-white to-indigo-50/40 border border-blue-200/90 shadow-md">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="space-y-2 flex-grow">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 text-xs font-bold rounded bg-blue-600 text-white">
          本站编辑推荐
        </span>
        <h3 class="text-xl font-extrabold text-slate-900">
          {customTitle || `${brand.name} • 专线代理与高速节点`}
        </h3>
      </div>
      <p class="text-sm text-slate-600 leading-relaxed max-w-2xl">
        {customDesc || brand.summary}
      </p>
      
      <!-- Specs row -->
      <div class="flex flex-wrap items-center gap-2 pt-1 text-xs text-slate-600">
        <span class="bg-white px-2.5 py-1 rounded-md border border-slate-200 font-medium">
          🚀 {brand.lineTypes[0]}
        </span>
        <span class="bg-white px-2.5 py-1 rounded-md border border-slate-200 font-medium">
          🔒 {brand.protocols.join('/')}
        </span>
        <span class="bg-white px-2.5 py-1 rounded-md border border-slate-200 font-medium">
          💰 ¥{brand.minPriceMonthly} /月起
        </span>
        {brand.coupon && (
          <span class="bg-amber-100/80 text-amber-900 px-2.5 py-1 rounded-md border border-amber-300 font-bold">
            券码: {brand.coupon} ({brand.couponDiscount || '专属优惠'})
          </span>
        )}
      </div>
    </div>

    <!-- Right Button -->
    <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto flex-shrink-0">
      <a
        href={brand.affiliateUrl}
        target={AFFILIATE_TARGET}
        rel={AFFILIATE_REL}
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md shadow-blue-500/20 transition transform active:scale-95"
      >
        <span>前往官网直达</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a
        href={`/brands/${brand.slug}/`}
        class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs border border-slate-300 transition"
      >
        查看完整评测报告
      </a>
    </div>
  </div>
</div>

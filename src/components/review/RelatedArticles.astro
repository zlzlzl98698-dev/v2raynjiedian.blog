---
import CompactArticleCard from '../cards/CompactArticleCard.astro';

export interface Props {
  articles: {
    id: string;
    title: string;
    url: string;
    pubDate: Date;
    cover?: string;
  }[];
  title?: string;
}

const { articles = [], title = '相关延伸阅读' } = Astro.props;
---

{articles.length > 0 && (
  <div class="my-10 p-6 rounded-2xl bg-white border border-slate-200/90 shadow-xs">
    <h3 class="text-lg font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <span>{title}</span>
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {articles.map((art) => (
        <CompactArticleCard
          title={art.title}
          url={art.url}
          pubDate={art.pubDate}
          cover={art.cover}
        />
      ))}
    </div>
  </div>
)}

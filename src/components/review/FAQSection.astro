---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FAQItem[];
  title?: string;
}

const { faqs = [], title = '常见问题解答 (FAQ)' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="my-10 pt-8 border-t border-slate-200">
    <div class="flex items-center gap-2 mb-6">
      <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
        ?
      </div>
      <h2 class="text-2xl font-bold text-slate-900 m-0 p-0 border-0">
        {title}
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-slate-50 rounded-xl border border-slate-200 p-4 transition [&_summary::-webkit-details-marker]:hidden open:bg-white open:ring-1 open:ring-blue-500/20 open:shadow-xs">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-slate-800 group-hover:text-blue-600 transition">
            <span class="flex items-center gap-2">
              <span class="text-xs font-mono text-blue-600 bg-blue-50 px-2 py-0.5 rounded">
                Q{index + 1}
              </span>
              <span>{faq.question}</span>
            </span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition transform duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-600 leading-relaxed">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
